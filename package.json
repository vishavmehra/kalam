  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "expo lint",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=high && npm --prefix functions audit --omit=dev --audit-level=high",
    "eval": "node scripts/eval.mjs",
    "eval:check": "node scripts/eval.mjs --check",
    "bench": "node scripts/bench.mjs",
    "eval:bazaar": "node scripts/eval-bazaar.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:eval": "vitest run --config tests/evaluation/vitest.config.ts",
    "build:web": "expo export --platform web && node scripts/build-pwa.mjs",
    "build:web:e2e": "node scripts/build-web-e2e.mjs",
    "e2e": "playwright test",
    "functions:serve": "firebase emulators:start --only functions",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kalam \"vitest run --config tests/rules/vitest.config.ts\"",
    "test:emulators": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-kalam \"vitest run --config tests/emulator/vitest.config.ts\"",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:test": "npm --prefix mcp test",
    "mcp:typecheck": "npm --prefix mcp run typecheck",
    "mcp:start": "node mcp/dist/server.js",
    "assets:render": "node assets/images/src/render.mjs",
    "assets:check": "node assets/images/src/render.mjs --check"
  },
  "private": true,
