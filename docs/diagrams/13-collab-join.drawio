<mxfile host="app.diagrams.net" type="device"><diagram id="13-collab-join" name="Collaboration: sharing an app and joining with kalamCollabJoin"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1010" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="L1" value="OWNER'S DEVICE" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="320" height="890" as="geometry"/></mxCell>
<mxCell id="L2" value="INVITEE'S DEVICE" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="320" height="890" as="geometry"/></mxCell>
<mxCell id="L3" value="CLOUD FUNCTION" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#E8E4DD;strokeColor=#1C1917;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="320" height="890" as="geometry"/></mxCell>
<mxCell id="L4" value="FIRESTORE, DATABASE kalam" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#E8E4DD;strokeColor=#1C1917;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="320" height="890" as="geometry"/></mxCell>
<mxCell id="o1" value="1  Share, with consent" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="o1_s" value="The owner signs in with a full account&#xa;and agrees, per app. Nothing is shared&#xa;before that." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o1"><mxGeometry x="0" y="27" width="280" height="81" as="geometry"/></mxCell>
<mxCell id="f1" value="collabApps/{sharedId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1100" y="130" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="f1_s" value="Owner, title, gzip spec, spec version,&#xa;team. Created by the owner under the&#xa;rules." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f1"><mxGeometry x="0" y="27" width="280" height="81" as="geometry"/></mxCell>
<mxCell id="o2" value="2  Create an invite" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="o2_s" value="Role (admin, editor or viewer), expiry,&#xa;use limit. The code is sharedId.secret:&#xa;20 base32 characters, 100 bits." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o2"><mxGeometry x="0" y="27" width="280" height="91" as="geometry"/></mxCell>
<mxCell id="f2" value="invites/{sha256(secret)}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1100" y="270" width="280" height="120" as="geometry"/></mxCell>
<mxCell id="f2_s" value="Role, expiry, uses, createdBy. The&#xa;secret itself is never stored." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f2"><mxGeometry x="0" y="27" width="280" height="91" as="geometry"/></mxCell>
<mxCell id="i1" value="3  Open the code or link" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="i1_s" value="kalam://join?c=... only fills in the&#xa;code. The person still presses Join." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i1"><mxGeometry x="0" y="27" width="280" height="71" as="geometry"/></mxCell>
<mxCell id="i2" value="4  Join" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="400" y="550" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="i2_s" value="Needs a full account, a connection and&#xa;consent. Calls kalamCollabJoin with the&#xa;code." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i2"><mxGeometry x="0" y="27" width="280" height="71" as="geometry"/></mxCell>
<mxCell id="fn1" value="kalamCollabJoin" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="750" y="550" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="fn1_s" value="App Check enforced. Guests refused. 20&#xa;tries per 10 minutes per user. The&#xa;secret is hashed with SHA-256." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fn1"><mxGeometry x="0" y="27" width="280" height="71" as="geometry"/></mxCell>
<mxCell id="fn2" value="One transaction: planJoin" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="750" y="690" width="280" height="160" as="geometry"/></mxCell>
<mxCell id="fn2_s" value="Shared app still active? An existing&#xa;member keeps their role. The invite&#xa;must exist, not be expired or used up,&#xa;and its creator must still outrank the&#xa;role. Then add the member, count the&#xa;use, write an audit entry." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fn2"><mxGeometry x="0" y="27" width="280" height="131" as="geometry"/></mxCell>
<mxCell id="f3" value="members/{uid} and audit" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="280" height="160" as="geometry"/></mxCell>
<mxCell id="f3_s" value="Role, public name (never the email),&#xa;joinedAt, addedBy. An audit entry&#xa;member_joined. Clients cannot add&#xa;members themselves." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f3"><mxGeometry x="0" y="27" width="280" height="131" as="geometry"/></mxCell>
<mxCell id="i3" value="5  Install the shared app" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="i3_s" value="Read the shared app, unpack and&#xa;validate its spec, save it locally as&#xa;an import, keep the role, then sync." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i3"><mxGeometry x="0" y="27" width="280" height="81" as="geometry"/></mxCell>
<mxCell id="i4" value="6  Sync entries" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="400" y="860" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="i4_s" value="Writes are version-checked. A clash is&#xa;merged field by field; a real conflict&#xa;is shown to the person." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i4"><mxGeometry x="0" y="27" width="280" height="71" as="geometry"/></mxCell>
<mxCell id="f4" value="records/{id}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1100" y="860" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="f4_s" value="Values, version, tombstone flag, who&#xa;changed it. Entries stay on each device&#xa;and work offline." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f4"><mxGeometry x="0" y="27" width="280" height="71" as="geometry"/></mxCell>
<mxCell id="title" value="Collaboration: sharing an app and joining with kalamCollabJoin" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1340" height="30" as="geometry"/></mxCell>
