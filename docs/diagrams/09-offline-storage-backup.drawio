<mxCell id="t9" value="aiCache" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="562" y="636" width="118" height="36" as="geometry"/></mxCell>
<mxCell id="t10" value="sessions" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="682" width="118" height="36" as="geometry"/></mxCell>
<mxCell id="t11" value="shareLinks" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="178" y="682" width="118" height="36" as="geometry"/></mxCell>
<mxCell id="t12" value="pendingOps" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="306" y="682" width="118" height="36" as="geometry"/></mxCell>
<mxCell id="b1" value="Read one consistent snapshot" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="100" width="600" height="60" as="geometry"/></mxCell>
<mxCell id="b1_s" value="Apps, versions, records, state, drawings, files, settings." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="b1"><mxGeometry x="0" y="27" width="600" height="31" as="geometry"/></mxCell>
<mxCell id="b2" value="Pack and compress" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="190" width="600" height="72" as="geometry"/></mxCell>
<mxCell id="b2_s" value="gzip of the manifest plus the payload. The manifest holds the SHA-256 of the exact&#xa;payload bytes." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="b2"><mxGeometry x="0" y="27" width="600" height="43" as="geometry"/></mxCell>
<mxCell id="b3" value="Encrypt on this device" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="292" width="600" height="120" as="geometry"/></mxCell>
<mxCell id="b3_s" value="AES-256-GCM. Key from the passphrase with PBKDF2-HMAC-SHA256, 310,000 iterations, a&#xa;random 16-byte salt per backup. Random 12-byte nonce. Header fields are bound in as&#xa;associated data. The passphrase (at least 10 characters) is never stored." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="b3"><mxGeometry x="0" y="27" width="600" height="91" as="geometry"/></mxCell>
<mxCell id="b4" value="Envelope file" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="442" width="600" height="84" as="geometry"/></mxCell>
<mxCell id="b4_s" value="kalam-encrypted-backup, format version 1: algorithm, kdf, iterations, salt, iv,&#xa;compression, ciphertext in base64. A file the person keeps, or ciphertext in their&#xa;account." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="b4"><mxGeometry x="0" y="27" width="600" height="55" as="geometry"/></mxCell>
<mxCell id="rs" value="Restore (all on this device)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="576" width="600" height="178" as="geometry"/></mxCell>
<mxCell id="rs_s" value="1  Read the envelope, derive the key&#xa;2  Authenticate and decrypt, check the SHA-256&#xa;3  Validate structure, specs, history, drawings, files, settings&#xa;4  Reset imported claims: AI steps become unverified&#xa;5  Rebuild the version history&#xa;6  Show what will change&#xa;7  Write everything in ONE transaction&#xa;A wrong passphrase or a changed file writes nothing." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="rs"><mxGeometry x="0" y="27" width="600" height="149" as="geometry"/></mxCell>
<mxCell id="o1" value="Saved apps open and run" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="830" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="o1_s" value="Render, add and edit records, calculate,&#xa;navigate and use local AI with no network." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o1"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="o2" value="Queued AI steps" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="390" y="830" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="o2_s" value="Steps that need the cloud wait in the&#xa;pendingOps table and finish when online. The&#xa;answer comes back as a proposal to accept." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o2"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="o3" value="Web app shell" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="730" y="830" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="o3_s" value="A service worker caches the PWA shell so the&#xa;app opens without a connection." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o3"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="o4" value="Cloud-only actions" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1070" y="830" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="o4_s" value="Fail clearly offline. The person keeps their&#xa;input and nothing is lost." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="o4"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="title" value="Offline-first storage, encrypted backup and restore" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1360" height="30" as="geometry"/></mxCell>
