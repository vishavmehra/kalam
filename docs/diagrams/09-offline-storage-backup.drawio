<mxCell id="tbl" value="TABLES (schema version 4)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#FDF0D8;strokeColor=#F2A541;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="660" height="204" as="geometry"/></mxCell>
<mxCell id="off" value="OFFLINE BEHAVIOUR" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#FDF0D8;strokeColor=#F2A541;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1380" height="170" as="geometry"/></mxCell>
<mxCell id="kdb" value="KalamDatabase (kalam-database.ts)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="kdb_s" value="Every data rule lives once: atomic save plus version append, version retention, record validation&#xa;and a cap per collection, per-app isolation, cascade delete of versions, records, state,&#xa;translations and owned files, event cap, validated backup import.&#xa;&#xa;App records live here and nowhere else, unless the person makes a backup or turns on account sync." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="kdb"><mxGeometry x="0" y="27" width="660" height="121" as="geometry"/></mxCell>
<mxCell id="drv" value="StoreTable driver port" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="660" height="56" as="geometry"/></mxCell>
<mxCell id="drv_s" value="A minimal table store that both backends implement." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="drv"><mxGeometry x="0" y="27" width="660" height="27" as="geometry"/></mxCell>
<mxCell id="web" value="Web: Dexie over IndexedDB" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="web_s" value="Schema versions in migrations.ts. Dexie runs&#xa;each upgrade in its own transaction." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="web"><mxGeometry x="0" y="27" width="320" height="91" as="geometry"/></mxCell>
<mxCell id="sql" value="Android and iOS: expo-sqlite" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="370" y="390" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="sql_s" value="One queue serialises statements. Tables are&#xa;key, index columns and JSON. Pending&#xa;migrations and the version bump run in ONE&#xa;transaction." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="sql"><mxGeometry x="0" y="27" width="320" height="91" as="geometry"/></mxCell>
