<mxCell id="lim" value="Up to 5,000 records per collection. AI cache: 500 answers, reused for up to 24 hours." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="726" width="620" height="20" as="geometry"/></mxCell>
