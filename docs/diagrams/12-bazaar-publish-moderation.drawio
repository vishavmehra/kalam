<mxfile host="app.diagrams.net" type="device"><diagram id="12-bazaar-publish-moderation" name="Kalam Bazaar: publish, safety check, moderation and install"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="920" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="st" value="LISTING STATUS (the verdict sets it: pass, published; flagged, rejected; review unavailable, pending_review)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="1420" height="150" as="geometry"/></mxCell>
<mxCell id="mod" value="MODERATION" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="1420" height="190" as="geometry"/></mxCell>
<mxCell id="inst" value="INSTALL AND PURCHASE" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1420" height="170" as="geometry"/></mxCell>
<mxCell id="p1" value="Maker taps Share" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="p1_s" value="Title, description,&#xa;category, price, license,&#xa;SVG icon, screenshots." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p1"><mxGeometry x="0" y="27" width="200" height="121" as="geometry"/></mxCell>
<mxCell id="p2" value="Validate" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="255" y="100" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="p2_s" value="validateSpec. Lineage&#xa;check: an installed app&#xa;cannot be re-shared; a&#xa;no-remix original blocks&#xa;copies." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p2"><mxGeometry x="0" y="27" width="200" height="121" as="geometry"/></mxCell>
<mxCell id="p3" value="Sanitize" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="240" height="150" as="geometry"/></mxCell>
<mxCell id="p3_s" value="New neutral id, public maker&#xa;name, device-local data removed,&#xa;validated again. At most 100 KB,&#xa;gzip at most 140,000 characters.&#xa;SVG icon passes an allowlist." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p3"><mxGeometry x="0" y="27" width="240" height="121" as="geometry"/></mxCell>
<mxCell id="p4" value="Deterministic flags" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="745" y="100" width="220" height="150" as="geometry"/></mxCell>
<mxCell id="p4_s" value="Prompt override, script-like&#xa;text, requests for passwords&#xa;or card details. No model&#xa;needed." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p4"><mxGeometry x="0" y="27" width="220" height="121" as="geometry"/></mxCell>
<mxCell id="p5" value="Cloud safety review" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="990" y="100" width="230" height="150" as="geometry"/></mxCell>
<mxCell id="p5_s" value="Firebase AI Logic, safety role.&#xa;Verdict pass or flagged, with&#xa;reasons. Reused while the spec&#xa;hash and listing text are&#xa;unchanged." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p5"><mxGeometry x="0" y="27" width="230" height="121" as="geometry"/></mxCell>
<mxCell id="p6" value="Write to Firestore" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1245" y="100" width="205" height="150" as="geometry"/></mxCell>
<mxCell id="p6_s" value="listings, listingSpecs,&#xa;listingMedia. Rules&#xa;re-check shape, status and&#xa;counters." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="p6"><mxGeometry x="0" y="27" width="205" height="121" as="geometry"/></mxCell>
<mxCell id="s0" value="published" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="332" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="s0_s" value="Visible to everyone. A maker&#xa;publishing never counts as reviewed." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s0"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="s1" value="pending_review" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="330" y="332" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="s1_s" value="Review unavailable. The maker can&#xa;recheck." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s1"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="s2" value="rejected" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="610" y="332" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="s2_s" value="Flagged: needs changes before it can&#xa;be shared." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s2"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="s3" value="unpublished" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="890" y="332" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="s3_s" value="The maker took it down." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s3"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="s4" value="suspended" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1170" y="332" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="s4_s" value="Set only by a moderator, through the&#xa;trusted function." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s4"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="m1" value="Readers report" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="270" height="130" as="geometry"/></mxCell>
<mxCell id="m1_s" value="reports: write-only, one per person&#xa;per listing. Reasons: malicious,&#xa;misleading, privacy, copyright, spam,&#xa;inappropriate, broken." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m1"><mxGeometry x="0" y="27" width="270" height="101" as="geometry"/></mxCell>
<mxCell id="m2" value="Moderator queue" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="350" y="520" width="310" height="130" as="geometry"/></mxCell>
<mxCell id="m2_s" value="kalamBazaarModerationList and&#xa;kalamBazaarStats. Needs the kalamModerator&#xa;claim, set by the owner with the Admin SDK." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m2"><mxGeometry x="0" y="27" width="310" height="101" as="geometry"/></mxCell>
<mxCell id="m3" value="Decide" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="690" y="520" width="380" height="130" as="geometry"/></mxCell>
<mxCell id="m3_s" value="kalamBazaarModerate: approve, reject, request changes,&#xa;suspend, unsuspend, feature, unfeature, hide or show a&#xa;review, reverse a purchase, recount totals." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m3"><mxGeometry x="0" y="27" width="380" height="101" as="geometry"/></mxCell>
<mxCell id="m4" value="Audit and counters" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="m4_s" value="A moderationLog entry for every decision.&#xa;Totals (installs, likes, ratings) are recounted&#xa;from the source documents." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m4"><mxGeometry x="0" y="27" width="330" height="101" as="geometry"/></mxCell>
<mxCell id="i1" value="Install or remix (free)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="650" height="110" as="geometry"/></mxCell>
<mxCell id="i1_s" value="Download the spec, check its SHA-256, migrate, run validateSpec, drop claimed trust (AI steps&#xa;unverified, generator removed) and save locally. An installed app is never overwritten silently." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i1"><mxGeometry x="0" y="27" width="650" height="81" as="geometry"/></mxCell>
<mxCell id="i2" value="Paid install" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="730" y="750" width="700" height="110" as="geometry"/></mxCell>
<mxCell id="i2_s" value="kalamBazaarPurchase: ONE transaction writes the entitlement, both wallets, the ledger entry and the&#xa;install count. A price changed since the page loaded is refused. Guests cannot use credits." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="i2"><mxGeometry x="0" y="27" width="700" height="81" as="geometry"/></mxCell>
