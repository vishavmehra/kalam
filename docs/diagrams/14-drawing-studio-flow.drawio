<mxfile host="app.diagrams.net" type="device"><diagram id="14-drawing-studio-flow" name="Drawing Studio: from strokes to a built app"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="820" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="d1" value="Canvas" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="300" height="230" as="geometry"/></mxCell>
<mxCell id="d1_s" value="Web: HTML Canvas 2D with pen pressure,&#xa;wheel and pinch zoom. Android and iOS:&#xa;Skia pictures with gesture handling; two&#xa;fingers cancel a stroke.&#xa;&#xa;Tools: pen, marker, highlighter,&#xa;rectangle, ellipse, line, arrow, text,&#xa;component stamps, photo, eraser, select,&#xa;group." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="d1"><mxGeometry x="0" y="27" width="300" height="201" as="geometry"/></mxCell>
<mxCell id="d2" value="Drawing document" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="480" height="230" as="geometry"/></mxCell>
<mxCell id="d2_s" value="Immutable pages: up to 8 screens, each 400 by 800, up to 500 objects.&#xa;&#xa;Stamps (button, list, text input, heading, stat, photo, toggle) give&#xa;the compiler structure. Objects can carry hints: header, nav, total,&#xa;list item.&#xa;&#xa;Snapshot history makes undo and redo exact." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="d2"><mxGeometry x="0" y="27" width="480" height="201" as="geometry"/></mxCell>
<mxCell id="d3" value="Autosave" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="910" y="100" width="240" height="230" as="geometry"/></mxCell>
<mxCell id="d3_s" value="Edits are debounced. One write at&#xa;a time. A failed write is retried&#xa;with a growing delay. Flushed&#xa;when the app goes to the&#xa;background or the studio closes." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="d3"><mxGeometry x="0" y="27" width="240" height="201" as="geometry"/></mxCell>
<mxCell id="d4" value="Local database" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="210" height="230" as="geometry"/></mxCell>
<mxCell id="d4_s" value="The drawings table. Every&#xa;load goes through&#xa;migrateDrawing, which&#xa;rebuilds the drawing field&#xa;by field and drops what it&#xa;cannot trust." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="d4"><mxGeometry x="0" y="27" width="210" height="201" as="geometry"/></mxCell>
<mxCell id="e1" value="Export and import" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="380" height="190" as="geometry"/></mxCell>
<mxCell id="e1_s" value="Export: PNG, SVG, PDF (raster pages) and .kalamdraw,&#xa;Kalam's own file.&#xa;&#xa;Import: SVG through a strict allowlist (no scripts,&#xa;links, use, image or styles) and .kalamdraw rebuilt&#xa;field by field. An import always makes a NEW drawing." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="e1"><mxGeometry x="0" y="27" width="380" height="161" as="geometry"/></mxCell>
<mxCell id="e2" value="Handwriting to text" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="380" height="190" as="geometry"/></mxCell>
<mxCell id="e2_s" value="1  Handwritten digits are matched on the device, no&#xa;model.&#xa;2  Anything else goes to Gemini Nano on the device,&#xa;only_on_device.&#xa;3  Only if that fails, cloud is allowed and the person&#xa;agrees: ONE cloud call.&#xa;&#xa;The person confirms the text before it replaces the&#xa;strokes." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="e2"><mxGeometry x="0" y="27" width="380" height="161" as="geometry"/></mxCell>
<mxCell id="e3" value="Build an app from the drawing" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="850" y="420" width="560" height="190" as="geometry"/></mxCell>
<mxCell id="e3_s" value="Stamps, text, shapes and hints become structure with no model. Arrows and repeated&#xa;rows become plain-sentence cues, and the person's own hints win.&#xa;&#xa;Typed text is scanned on the device for card numbers, IDs, phones, emails and&#xa;secrets, and Kalam asks before anything goes to the cloud. Rasterised pages go to&#xa;cloud vision only if needed." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="e3"><mxGeometry x="0" y="27" width="560" height="161" as="geometry"/></mxCell>
<mxCell id="norm" value="NormalizedInput.drawing, then the creation pipeline" style="rounded=1;absoluteArcSize=1;arcSize=30;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="850" y="680" width="560" height="60" as="geometry"/></mxCell>
<mxCell id="title" value="Drawing Studio: from strokes to a built app" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1360" height="30" as="geometry"/></mxCell>
<mxCell id="source" value="Source: src/features/drawing (canvas, model/*, autosave, handwriting-service, drawing-actions), docs/08" style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1360" height="18" as="geometry"/></mxCell>
