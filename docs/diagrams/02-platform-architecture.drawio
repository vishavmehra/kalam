<mxCell id="fbn_s" value="Firebase AI Logic, Auth, Firestore (kalam),&#xa;Cloud Functions (kalam). See the system context." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fbn"><mxGeometry x="0" y="27" width="340" height="55" as="geometry"/></mxCell>
