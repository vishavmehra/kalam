<mxfile host="app.diagrams.net" type="device"><diagram id="02-platform-architecture" name="Platform architecture: one codebase, four targets"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="870" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="l1" value="App shell and features" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="830" height="84" as="geometry"/></mxCell>
<mxCell id="l1_s" value="src/app: Expo Router routes (shelf, create, app/[id], bazaar, account, settings, join, import).&#xa;src/features: create, drawing, bazaar, collab, history, widgets, voice, reports and more." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l1"><mxGeometry x="0" y="27" width="830" height="55" as="geometry"/></mxCell>
<mxCell id="l2" value="Runtime, design, i18n, state" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="210" width="830" height="70" as="geometry"/></mxCell>
<mxCell id="l2_s" value="src/runtime (KalamRuntime, engine, component registry), src/design, src/i18n (10 languages), src/state (Zustand stores)." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l2"><mxGeometry x="0" y="27" width="830" height="41" as="geometry"/></mxCell>
<mxCell id="l3" value="Composition root" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="306" width="830" height="70" as="geometry"/></mxCell>
<mxCell id="l3_s" value="src/services/index.ts: getServices() builds the database, auth, orchestrator, pipeline, backup and Bazaar services. The only&#xa;place that wires infrastructure to core." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l3"><mxGeometry x="0" y="27" width="830" height="41" as="geometry"/></mxCell>
<mxCell id="l4" value="src/core: pure TypeScript, no React, no SDK" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="404" width="830" height="122" as="geometry"/></mxCell>
<mxCell id="l4_s" value="spec, compiler, classifier, templates, pipeline, ai (routing, orchestrator, cache, limits), formula, edit, history,&#xa;versioning, media, review, backup, bazaar, collab, account-sync, share, queue, widgets, import-link, limits, observability.&#xa;Every other layer depends on it; it depends on ports only." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l4"><mxGeometry x="0" y="27" width="830" height="93" as="geometry"/></mxCell>
<mxCell id="l5" value="src/infrastructure: adapters behind the ports" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="558" width="830" height="84" as="geometry"/></mxCell>
<mxCell id="l5_s" value="firebase (AI Logic, Auth, App Check, Firestore, Remote Config), storage (Dexie, expo-sqlite), platform (speech, TTS, media,&#xa;network), bazaar, collab, account-sync, specialist, pwa. Metro picks .web, .native or .ios files." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l5"><mxGeometry x="0" y="27" width="830" height="55" as="geometry"/></mxCell>
<mxCell id="web" value="Web (PWA)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="130" y="700" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="web_s" value="Expo web export on Firebase Hosting.&#xa;IndexedDB (Dexie). Chrome Prompt API&#xa;(Gemini Nano). reCAPTCHA Enterprise.&#xa;Service worker." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="web"><mxGeometry x="0" y="27" width="260" height="91" as="geometry"/></mxCell>
<mxCell id="and" value="Android" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="415" y="700" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="and_s" value="expo-sqlite. kalam-nano (Kotlin):&#xa;Gemini Nano via ML Kit Prompt API on&#xa;AICore, Play Integrity. Home-screen&#xa;widget." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="and"><mxGeometry x="0" y="27" width="260" height="91" as="geometry"/></mxCell>
<mxCell id="ios" value="iOS" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="ios_s" value="expo-sqlite. kalam-apple (Swift):&#xa;Apple Foundation Models, App Attest.&#xa;WidgetKit widget. Same JS as&#xa;Android." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="ios"><mxGeometry x="0" y="27" width="260" height="91" as="geometry"/></mxCell>
<mxCell id="mcp" value="MCP server (mcp/)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1050" y="404" width="340" height="122" as="geometry"/></mxCell>
<mxCell id="mcp_s" value="esbuild bundles the pure src/core code into one&#xa;Node file. Stdio by default, or Streamable HTTP&#xa;on 127.0.0.1. 11 deterministic tools; workspace&#xa;and Firebase tools are opt-in." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="mcp"><mxGeometry x="0" y="27" width="340" height="93" as="geometry"/></mxCell>
