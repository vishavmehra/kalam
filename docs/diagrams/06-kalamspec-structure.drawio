<mxfile host="app.diagrams.net" type="device"><diagram id="06-kalamspec-structure" name="KalamSpec 1.1: an app is data, never code"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="700" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="root" value="KalamSpec 1.1.0 (one JSON document, at most 100 KB)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1170" height="74" as="geometry"/></mxCell>
<mxCell id="root_s" value="id, schemaVersion, version, name, description, icon, lang, initialScreen. Rendered only after validateSpec accepts it. No script, no eval, no URLs that run." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="root"><mxGeometry x="0" y="27" width="1170" height="45" as="geometry"/></mxCell>
<mxCell id="screens" value="screens[] (1 to 8)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="270" height="270" as="geometry"/></mxCell>
<mxCell id="screens_s" value="id, title, description&#xa;form: the collection its inputs bind&#xa;to&#xa;children[]: components&#xa;layout[]: row, grid, card groups&#xa;(1.1)&#xa;&#xa;Components: text, heading, number,&#xa;textInput, date, choice, toggle,&#xa;counter, bigButton, list, stat,&#xa;photo. New in 1.1: chart, timer,&#xa;reminder, signature." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="screens"><mxGeometry x="0" y="27" width="270" height="241" as="geometry"/></mxCell>
<mxCell id="actions" value="actions{}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="270" height="270" as="geometry"/></mxCell>
<mxCell id="actions_s" value="A finite set, interpreted by the&#xa;engine:&#xa;&#xa;navigate, insert, update, delete,&#xa;increment, decrement, reset, runAI,&#xa;speak, feedback, clearForm.&#xa;&#xa;New in 1.1: compute (writes a formula&#xa;result).&#xa;&#xa;intents{}: phrases that voice&#xa;commands map to an action id." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="actions"><mxGeometry x="0" y="27" width="270" height="241" as="geometry"/></mxCell>
<mxCell id="ai" value="aiBlocks{}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="640" y="230" width="270" height="270" as="geometry"/></mxCell>
<mxCell id="ai_s" value="Four kinds: extractFromPhoto,&#xa;classify, summarise, translate.&#xa;&#xa;Each has a prompt, verified&#xa;(onDevice, cloudPreferred,&#xa;unverified), fallback (cloud or none)&#xa;and onError.&#xa;&#xa;Always start unverified. A model or&#xa;an imported file cannot claim&#xa;otherwise." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="ai"><mxGeometry x="0" y="27" width="270" height="241" as="geometry"/></mxCell>
<mxCell id="cols" value="collections{}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="270" height="270" as="geometry"/></mxCell>
<mxCell id="cols_s" value="Record id to fields.&#xa;&#xa;Field types: text, number, date,&#xa;boolean, enum, image.&#xa;&#xa;ref: a field can link to an entry of&#xa;another collection, with onDelete&#xa;restrict, cascade or clear (1.1).&#xa;&#xa;At most 10 collections." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="cols"><mxGeometry x="0" y="27" width="270" height="241" as="geometry"/></mxCell>
<mxCell id="other" value="Other sections" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1260" y="230" width="280" height="270" as="geometry"/></mxCell>
<mxCell id="other_s" value="theme: colours, radius, fontScale,&#xa;spacing, fontFamily&#xa;&#xa;meta: author, dates, source (template,&#xa;compiler, import, remix, manual),&#xa;license, generator&#xa;&#xa;Optional in 1.1: permissions (camera,&#xa;notifications), accessibility, settings&#xa;(currency, time format), localization&#xa;(terminology)." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="other"><mxGeometry x="0" y="27" width="280" height="241" as="geometry"/></mxCell>
<mxCell id="title" value="KalamSpec 1.1: an app is data, never code" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="30" as="geometry"/></mxCell>
<mxCell id="source" value="Source: src/core/spec/schema.ts (SCHEMA_VERSION 1.1.0), limits/policy.ts, docs/05_KALAMSPEC.md" style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="18" as="geometry"/></mxCell>
<mxCell id="note" value="Dashed lines are references the validator checks: every id must exist, every input field must match its&#xa;collection field type." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="700" height="20" as="geometry"/></mxCell>
