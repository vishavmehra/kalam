<mxfile host="app.diagrams.net" type="device"><diagram id="10-account-sync-google-signin" name="Account: Google sign-in and opt-in sync"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="l1" value="KALAM APP" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="370" height="760" as="geometry"/></mxCell>
<mxCell id="l2" value="GOOGLE" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="320" height="760" as="geometry"/></mxCell>
<mxCell id="l3" value="FIREBASE AUTH" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#E8E4DD;strokeColor=#1C1917;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="280" height="760" as="geometry"/></mxCell>
<mxCell id="l4" value="FIRESTORE, DATABASE kalam" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#E8E4DD;strokeColor=#1C1917;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="300" height="760" as="geometry"/></mxCell>
<mxCell id="s1" value="1  Continue with Google" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="s1_s" value="Signing in is required to use Kalam (ADR-040).&#xa;Email and password is the other way in." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s1"><mxGeometry x="0" y="27" width="330" height="81" as="geometry"/></mxCell>
<mxCell id="s2" value="2  Google proves who you are" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="s2_s" value="Web: a popup. Android and iOS: the&#xa;native Google Sign-In SDK returns an ID&#xa;token for Kalam's web OAuth client." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s2"><mxGeometry x="0" y="27" width="280" height="81" as="geometry"/></mxCell>
<mxCell id="s3" value="3  signInWithCredential" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="s3_s" value="Verifies the token. An anonymous&#xa;session from an older build is&#xa;linked, so its uid is kept." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s3"><mxGeometry x="0" y="27" width="240" height="81" as="geometry"/></mxCell>
<mxCell id="s4" value="4  Signed in" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="s4_s" value="The saved session keeps working offline." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s4"><mxGeometry x="0" y="27" width="330" height="41" as="geometry"/></mxCell>
<mxCell id="s5" value="5  Pick a sync choice" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="330" height="80" as="geometry"/></mxCell>
<mxCell id="s5_s" value="Off, apps, or apps and records. Chosen per&#xa;device. Sync never blocks using an app." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s5"><mxGeometry x="0" y="27" width="330" height="51" as="geometry"/></mxCell>
<mxCell id="s6" value="6  One sync pass" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="s6_s" value="Pull what changed, then plan each app by&#xa;comparing design hashes: upload, download,&#xa;conflict or delete tombstone. If both sides&#xa;changed, last writer wins and the losing design&#xa;stays in the Time Machine." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s6"><mxGeometry x="0" y="27" width="330" height="111" as="geometry"/></mxCell>
<mxCell id="s7" value="7  Back up records" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="732" width="330" height="100" as="geometry"/></mxCell>
<mxCell id="s7_s" value="Only for &quot;apps and records&quot;. Encrypted on the&#xa;device. The passphrase never leaves it." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s7"><mxGeometry x="0" y="27" width="330" height="71" as="geometry"/></mxCell>
<mxCell id="f1" value="users/{uid}/apps/{appId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="f1_s" value="Design only: gzip plus base64, up to&#xa;100 KB, name, icon, version, deleted&#xa;flag." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f1"><mxGeometry x="0" y="27" width="260" height="61" as="geometry"/></mxCell>
<mxCell id="f2" value="users/{uid}/backups/records_*" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="727" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="f2_s" value="AES-256-GCM chunks under 900 KB, at&#xa;most 40 parts." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f2"><mxGeometry x="0" y="27" width="260" height="81" as="geometry"/></mxCell>
<mxCell id="f3" value="users/{uid}/account/records" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="612" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="f3_s" value="Pointer to the newest complete&#xa;backup set." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="f3"><mxGeometry x="0" y="27" width="260" height="41" as="geometry"/></mxCell>
<mxCell id="title" value="Account: Google sign-in and opt-in sync" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1340" height="30" as="geometry"/></mxCell>
<mxCell id="source" value="Source: src/infrastructure/firebase (auth-core, auth.web, auth-google.native), src/core/account-sync (model, plan, engine, records), firestore.rules users/{uid}" style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1340" height="18" as="geometry"/></mxCell>
<mxCell id="rules" value="firestore.rules: only the signed-in&#xa;owner can read or write these documents,&#xa;each write is shape-checked, and records&#xa;are ciphertext only. Sign-out keeps&#xa;everything on the device." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1110" y="160" width="260" height="130" as="geometry"/></mxCell>
