<mxfile host="app.diagrams.net" type="device"><diagram id="20-ai-blocks-and-verification" name="AI blocks inside generated apps: verified at build, proposed at run"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="800" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="g1" value="BUILD TIME: CHECKING AN AI STEP (the verifying stage, at most 30 seconds)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1380" height="190" as="geometry"/></mxCell>
<mxCell id="g2" value="RUN TIME: USING AN AI STEP IN A SAVED APP" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="1380" height="450" as="geometry"/></mxCell>
<mxCell id="v1" value="Cheap checks first" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="132" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="v1_s" value="No Nano, offline, cloud help off&#xa;or a model still loading: an&#xa;honest &quot;not checked yet&quot;, with no&#xa;model call." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v1"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="v2" value="Cloud writes 5 test cases" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="320" y="132" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="v2_s" value="One Firebase call per AI step.&#xa;Photo steps wait for real sample&#xa;photos." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v2"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="v3" value="Gemini Nano runs them" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="590" y="132" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="v3_s" value="On this device, through the same&#xa;orchestrator as every other AI&#xa;task." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v3"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="v4" value="Grade" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="860" y="132" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="v4_s" value="Deterministic first. A cloud judge&#xa;only for open-ended kinds:&#xa;summarise and translate." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v4"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="v5" value="Record the result" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1130" y="132" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="v5_s" value="A step is marked verified on&#xa;device only when its tests really&#xa;ran and passed. Otherwise it stays&#xa;unverified." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v5"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="r1" value="The person taps a runAI button" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="362" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r1_s" value="extractFromPhoto, classify, summarise or&#xa;translate. Each kind is one typed job with&#xa;one schema." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r1"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r2" value="Offline guard" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="380" y="362" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r2_s" value="A cloud-preferred step is refused offline&#xa;before the photo picker opens. A step set&#xa;to device only never needs the cloud." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r2"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r3" value="Orchestrator" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="710" y="362" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r3_s" value="prefer_on_device. If the device fails, ONE&#xa;Firebase cloud attempt, unless the step is&#xa;device only. Reused answers come from the&#xa;cache." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r3"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r4" value="Coerce and bound" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1040" y="362" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r4_s" value="Only the fields the step declares. Every&#xa;value is converted to its destination type&#xa;and limited before anything is shown." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r4"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r5" value="Proposal with its source" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1040" y="572" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r5_s" value="The answer appears with a badge: on&#xa;device, cloud or offline. Nothing is&#xa;written yet." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r5"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r6" value="The person accepts" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="710" y="572" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r6_s" value="Accepting fills the form on that screen,&#xa;and the app then saves it like any other&#xa;entry." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r6"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
<mxCell id="r7" value="Queued steps" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="380" y="572" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r7_s" value="A step that finished while the app was&#xa;closed or offline comes back as a proposal&#xa;and is checked exactly like a live one." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r7"><mxGeometry x="0" y="27" width="300" height="121" as="geometry"/></mxCell>
