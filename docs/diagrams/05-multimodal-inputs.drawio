<mxCell id="in0_s" value="Typed request, up to&#xa;4000 characters." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="in0"><mxGeometry x="0" y="27" width="160" height="93" as="geometry"/></mxCell>
<mxCell id="s10" value="Kept as data" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="225" y="96" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s10_s" value="Wrapped in untrusted tags so it&#xa;is data, never instructions to&#xa;the model." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s10"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="s20" value="Classifier signals" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="495" y="96" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s20_s" value="Entities, relationships and&#xa;template fit feed the complexity&#xa;classifier." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s20"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="in1" value="Photo or sketch" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="238" width="160" height="122" as="geometry"/></mxCell>
<mxCell id="in1_s" value="Camera or file, up&#xa;to 4 photos." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="in1"><mxGeometry x="0" y="27" width="160" height="93" as="geometry"/></mxCell>
<mxCell id="s11" value="Check and shrink" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="225" y="238" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s11_s" value="Type read from the first bytes,&#xa;not the file name. JPEG up to&#xa;1280 px. Crop on the web." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s11"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="s21" value="Cloud vision" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="495" y="238" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s21_s" value="Gemini in the cloud reads the&#xa;image. The Android and iOS&#xa;device models take text only." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s21"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="in2" value="Voice" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="160" height="122" as="geometry"/></mxCell>
<mxCell id="in2_s" value="Dictation, or an&#xa;audio file where the&#xa;platform can read&#xa;one." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="in2"><mxGeometry x="0" y="27" width="160" height="93" as="geometry"/></mxCell>
<mxCell id="s12" value="Speech to text" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="225" y="380" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s12_s" value="On-device recognition when&#xa;installed. The platform speech&#xa;service only with the person's&#xa;OK." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s12"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="s22" value="Transcript to edit" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="495" y="380" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s22_s" value="The first text is kept as the&#xa;original. Language found from&#xa;the script (10 languages)." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s22"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="in3" value="Video" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="160" height="122" as="geometry"/></mxCell>
<mxCell id="in3_s" value="Up to 60 seconds." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="in3"><mxGeometry x="0" y="27" width="160" height="93" as="geometry"/></mxCell>
<mxCell id="s13" value="Keyframes" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="225" y="522" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s13_s" value="Up to 6 evenly spaced frames,&#xa;near-duplicates dropped. The&#xa;video stays on the device." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s13"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="s23" value="Steps to confirm" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="495" y="522" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s23_s" value="A draft workflow from frames and&#xa;speech. The person edits it&#xa;before building." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s23"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="in4" value="Drawing Studio" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="160" height="122" as="geometry"/></mxCell>
<mxCell id="in4_s" value="Pages of strokes,&#xa;shapes, text and&#xa;component stamps." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="in4"><mxGeometry x="0" y="27" width="160" height="93" as="geometry"/></mxCell>
<mxCell id="s14" value="Deterministic summary" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="225" y="664" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s14_s" value="Stamps, text, shapes and hints&#xa;are read as structure, with no&#xa;model." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s14"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="s24" value="Pages for vision" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="495" y="664" width="235" height="122" as="geometry"/></mxCell>
<mxCell id="s24_s" value="Rasterised pages go to cloud&#xa;vision only if needed. Typed&#xa;text is checked for private&#xa;details first." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="s24"><mxGeometry x="0" y="27" width="235" height="93" as="geometry"/></mxCell>
<mxCell id="norm" value="NormalizedInput" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="770" y="96" width="190" height="690" as="geometry"/></mxCell>
<mxCell id="norm_s" value="One contract for the&#xa;pipeline:&#xa;&#xa;text&#xa;modalities&#xa;images&#xa;audioTranscript&#xa;video frames and summary&#xa;drawing summary&#xa;language&#xa;preferences&#xa;&#xa;Raw audio and raw video&#xa;never enter it." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="norm"><mxGeometry x="0" y="27" width="190" height="661" as="geometry"/></mxCell>
<mxCell id="conf" value="Check for conflicts" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="180" height="150" as="geometry"/></mxCell>
<mxCell id="conf_s" value="Deterministic. The text&#xa;says 3 fields, the&#xa;drawing shows 5 stamps:&#xa;each clash becomes a&#xa;question. Nothing is&#xa;silently dropped." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="conf"><mxGeometry x="0" y="27" width="180" height="121" as="geometry"/></mxCell>
