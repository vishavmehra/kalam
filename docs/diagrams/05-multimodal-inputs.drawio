<mxCell id="rev_s" value="Plain-language&#xa;summary of what&#xa;Kalam understood.&#xa;The person corrects&#xa;it, then builds." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="rev"><mxGeometry x="0" y="44" width="160" height="104" as="geometry"/></mxCell>
