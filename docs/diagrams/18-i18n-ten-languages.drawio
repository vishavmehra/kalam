<mxCell id="l2" value="This app" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="326" width="290" height="84" as="geometry"/></mxCell>
<mxCell id="l2_s" value="spec.lang, set per app. No other setting&#xa;changes it." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l2"><mxGeometry x="0" y="27" width="290" height="55" as="geometry"/></mxCell>
<mxCell id="l3" value="Speech to text" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="424" width="290" height="84" as="geometry"/></mxCell>
<mxCell id="l3_s" value="Dictation language.&#xa;settings.speech.sttLanguage." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l3"><mxGeometry x="0" y="27" width="290" height="55" as="geometry"/></mxCell>
<mxCell id="l4" value="Read aloud" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="522" width="290" height="84" as="geometry"/></mxCell>
<mxCell id="l4_s" value="Text-to-speech language.&#xa;settings.speech.ttsLanguage." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l4"><mxGeometry x="0" y="27" width="290" height="55" as="geometry"/></mxCell>
<mxCell id="m1" value="Translator" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="420" y="119" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="m1_s" value="Looks a key up in the selected language, then&#xa;English, then the default value, then empty.&#xa;A raw key is never shown. Plurals use&#xa;Intl.PluralRules or built-in CLDR rules.&#xa;Numbers group the Indian way with Latin&#xa;digits." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m1"><mxGeometry x="0" y="27" width="320" height="121" as="geometry"/></mxCell>
<mxCell id="m2" value="Catalogues" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="m2_s" value="One JSON file per language, loaded on demand.&#xa;English is bundled, so the fallback always&#xa;exists. Keys are typed from the English file." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m2"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="m3" value="Script fonts" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="420" y="440" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="m3_s" value="Noto Sans for the eight Indic scripts, four&#xa;weights each, loaded only for the scripts in&#xa;use. A generated app takes the font of its&#xa;own language." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m3"><mxGeometry x="0" y="27" width="320" height="101" as="geometry"/></mxCell>
<mxCell id="m4" value="Text handling" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="m4_s" value="Length and truncation count graphemes, so&#xa;Hindi and Tamil are never cut in half.&#xa;Right-to-left is prepared but not enabled:&#xa;all ten languages run left to right." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m4"><mxGeometry x="0" y="27" width="320" height="121" as="geometry"/></mxCell>
