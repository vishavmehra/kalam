<mxCell id="tr" value="Translating the labels of one app" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="470" width="600" height="190" as="geometry"/></mxCell>
<mxCell id="tr_s" value="The translate service asks the device first only when the on-device model can read and&#xa;write both languages (English only today). Otherwise Firebase cloud, with at most one&#xa;cloud fallback. Offline, only saved translations are used.&#xa;&#xa;The result is display only: the canonical spec is never edited. Translations live in a&#xa;per-app cache and the person can review and correct them." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="tr"><mxGeometry x="0" y="27" width="600" height="161" as="geometry"/></mxCell>
<mxCell id="title" value="Internationalisation: ten languages, five independent settings" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1360" height="30" as="geometry"/></mxCell>
