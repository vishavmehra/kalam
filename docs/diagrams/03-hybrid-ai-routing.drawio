<mxCell id="fb" value="Firebase AI Logic: cloud models" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="500" y="790" width="300" height="96" as="geometry"/></mxCell>
<mxCell id="fb_s" value="gemini-3.8-flash: compile, repair, judge.&#xa;gemini-3.5-flash-lite: everything else.&#xa;App Check token on every call." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fb"><mxGeometry x="0" y="27" width="300" height="67" as="geometry"/></mxCell>
<mxCell id="val" value="Zod parse, then validateSpec: invalid&#xa;output is rejected" style="rounded=1;absoluteArcSize=1;arcSize=28;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="500" y="932" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="r1" value="Run deterministically" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="900" y="170" width="400" height="78" as="geometry"/></mxCell>
<mxCell id="r1_s" value="Calculations, CRUD, navigation, validation, storage,&#xa;theme. No model is called." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r1"><mxGeometry x="0" y="27" width="400" height="49" as="geometry"/></mxCell>
<mxCell id="r2" value="Template build" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="900" y="273" width="400" height="112" as="geometry"/></mxCell>
<mxCell id="r2_s" value="Code builds the KalamSpec from the matched template.&#xa;Gemini Nano may fill missing parameters on this device&#xa;within a short budget; the template defaults are the&#xa;fallback." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r2"><mxGeometry x="0" y="27" width="400" height="83" as="geometry"/></mxCell>
<mxCell id="r3" value="Specialist (optional)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#A8A29E;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="400" height="112" as="geometry"/></mxCell>
<mxCell id="r3_s" value="kalamSpecialistReason Cloud Function: Claude plans and&#xa;repairs, Nebius reads sketches. Needs external-provider&#xa;consent and a stated reason. No cascade to Firebase." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="r3"><mxGeometry x="0" y="27" width="400" height="83" as="geometry"/></mxCell>
<mxCell id="l4" value="On device" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="400" height="122" as="geometry"/></mxCell>
<mxCell id="l4_s" value="Asked through the Firebase AI Logic hybrid SDK: Gemini&#xa;Nano (web, Android) or Apple Foundation Models (iOS), text&#xa;only. Classify, summarize, translate, voice, patch,&#xa;extract. only_on_device is never widened to cloud." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l4"><mxGeometry x="0" y="27" width="400" height="93" as="geometry"/></mxCell>
<mxCell id="l5" value="Fail clearly" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#E2583E;strokeWidth=1.5;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="40" y="647" width="400" height="84" as="geometry"/></mxCell>
<mxCell id="l5_s" value="Plain message, input kept, nothing sent. Offline, consent&#xa;off, or Firebase not set up." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="l5"><mxGeometry x="0" y="27" width="400" height="55" as="geometry"/></mxCell>
<mxCell id="g" value="Around every cloud call" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="400" height="160" as="geometry"/></mxCell>
<mxCell id="g_s" value="• one-time cloud notice before the first call&#xa;• client rate limit: token bucket per task&#xa;• result cache: 500 entries, 24 h, safe tasks only&#xa;• time budget: 2x the task timeout&#xa;• retries: 2 on 429, 5xx or network, 1 on timeout&#xa;• at most ONE cloud fallback after a device failure" style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="g"><mxGeometry x="0" y="27" width="400" height="131" as="geometry"/></mxCell>
