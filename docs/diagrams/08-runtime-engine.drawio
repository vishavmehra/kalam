<mxfile host="app.diagrams.net" type="device"><diagram id="08-runtime-engine" name="Runtime engine: a validated spec becomes a working app"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="960" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="eng" value="ENGINE (pure TypeScript, no network)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="220" y="480" width="520" height="410" as="geometry"/></mxCell>
<mxCell id="spec" value="Validated KalamSpec (shelf, template, compiler, import)" style="rounded=1;absoluteArcSize=1;arcSize=22;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="220" y="90" width="520" height="44" as="geometry"/></mxCell>
<mxCell id="rt" value="KalamRuntime (React Native)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="220" y="164" width="520" height="76" as="geometry"/></mxCell>
<mxCell id="rt_s" value="Makes one RuntimeContext per running app: appId, spec, services, Access&#xa;Modes, theme, data snapshot, formula cache. Swaps the spec on a live edit." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="rt"><mxGeometry x="0" y="27" width="520" height="47" as="geometry"/></mxCell>
<mxCell id="reg" value="Component registry" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="220" y="270" width="520" height="76" as="geometry"/></mxCell>
<mxCell id="reg_s" value="One map, one renderer per component type, checked against the schema. An&#xa;unknown type draws a quiet note and the rest of the screen keeps working." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="reg"><mxGeometry x="0" y="27" width="520" height="47" as="geometry"/></mxCell>
<mxCell id="ui" value="UI renderers" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="220" y="376" width="520" height="70" as="geometry"/></mxCell>
<mxCell id="ui_s" value="Views for text, inputs, list, stat, chart, photo, timer and more. They hold&#xa;no state of their own." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="ui"><mxGeometry x="0" y="27" width="520" height="41" as="geometry"/></mxCell>
<mxCell id="st" value="State reducers" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="240" y="516" width="230" height="118" as="geometry"/></mxCell>
<mxCell id="st_s" value="Navigation stack, per-screen&#xa;forms, errors and record&#xa;selection. Each returns a new&#xa;state." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="st"><mxGeometry x="0" y="27" width="230" height="89" as="geometry"/></mxCell>
<mxCell id="dp" value="Action dispatcher" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="490" y="516" width="230" height="118" as="geometry"/></mxCell>
<mxCell id="dp_s" value="navigate, insert, update,&#xa;delete, increment, decrement,&#xa;reset, runAI, speak, feedback,&#xa;clearForm, compute. Never runs&#xa;code." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="dp"><mxGeometry x="0" y="27" width="230" height="89" as="geometry"/></mxCell>
<mxCell id="fm" value="Formula evaluator" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="240" y="650" width="230" height="104" as="geometry"/></mxCell>
<mxCell id="fm_s" value="Whitelist: sum, count, avg,&#xa;min, max, filter, if, round,&#xa;abs, len, concat, month, week,&#xa;streak. No eval." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fm"><mxGeometry x="0" y="27" width="230" height="75" as="geometry"/></mxCell>
<mxCell id="tx" value="Transactions" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="490" y="650" width="230" height="104" as="geometry"/></mxCell>
<mxCell id="tx_s" value="Multi-step writes are one unit:&#xa;records.batch, or undo what was&#xa;done if a later write fails." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="tx"><mxGeometry x="0" y="27" width="230" height="75" as="geometry"/></mxCell>
<mxCell id="dt" value="Data and stats" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="240" y="770" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="dt_s" value="List filters, sort, stat values&#xa;and counters read from the data&#xa;snapshot." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="dt"><mxGeometry x="0" y="27" width="230" height="71" as="geometry"/></mxCell>
<mxCell id="vc" value="Voice planner" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="490" y="770" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="vc_s" value="A heard command becomes refuse,&#xa;fill, run or confirm.&#xa;Destructive actions always ask&#xa;first." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="vc"><mxGeometry x="0" y="27" width="230" height="71" as="geometry"/></mxCell>
<mxCell id="sv" value="RuntimeServices (port)" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="900" y="516" width="480" height="124" as="geometry"/></mxCell>
<mxCell id="sv_s" value="records, state (key-value), runAIBlock, speak, pickImage, confirm,&#xa;online. Previews keep records in memory; saved apps use the local&#xa;database." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="sv"><mxGeometry x="0" y="27" width="480" height="95" as="geometry"/></mxCell>
<mxCell id="db" value="Local database" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="150" height="156" as="geometry"/></mxCell>
<mxCell id="db_s" value="Records and state&#xa;per app. IndexedDB&#xa;or SQLite. Works&#xa;offline." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="db"><mxGeometry x="0" y="27" width="150" height="127" as="geometry"/></mxCell>
<mxCell id="ai" value="AI orchestrator" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1070" y="700" width="150" height="156" as="geometry"/></mxCell>
<mxCell id="ai_s" value="Only for runAI&#xa;steps.&#xa;Cloud-preferred&#xa;steps are refused&#xa;offline. The person&#xa;approves each&#xa;result." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="ai"><mxGeometry x="0" y="27" width="150" height="127" as="geometry"/></mxCell>
<mxCell id="dv" value="Speech, camera" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F2A541;strokeColor=#C77D0E;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1240" y="700" width="140" height="156" as="geometry"/></mxCell>
<mxCell id="dv_s" value="Read aloud, photo&#xa;picker, confirm&#xa;dialogs. No&#xa;network." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#3B2A0A;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="dv"><mxGeometry x="0" y="27" width="140" height="127" as="geometry"/></mxCell>
