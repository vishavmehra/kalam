<mxfile host="app.diagrams.net" type="device"><diagram id="15-mcp-server-tools" name="MCP server: tools, resources and what comes out"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0" background="#FAF7F2"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="srv" value="kalam-mcp (Node 20 or newer, one esbuild bundle)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="730" height="700" as="geometry"/></mxCell>
<mxCell id="ga" value="ALWAYS ON: 11 TOOLS, NO FILES, NO NETWORK, NO MODEL" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#FAF7F2;strokeColor=#D6D3D1;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="690" height="290" as="geometry"/></mxCell>
<mxCell id="host" value="MCP host" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="host_s" value="Claude Desktop, Claude Code&#xa;or any MCP host." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="host"><mxGeometry x="0" y="27" width="210" height="71" as="geometry"/></mxCell>
<mxCell id="tr" value="Transport" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="210" height="250" as="geometry"/></mxCell>
<mxCell id="tr_s" value="Stdio by default: stdout&#xa;carries the protocol, logs&#xa;go to stderr.&#xa;&#xa;--http [--port 3917]:&#xa;Streamable HTTP on 127.0.0.1&#xa;only. No login, so it cannot&#xa;be combined with --workspace&#xa;or --firebase. Host and&#xa;Origin checks stop DNS&#xa;rebinding." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="tr"><mxGeometry x="0" y="27" width="210" height="221" as="geometry"/></mxCell>
