<mxCell id="t10" value="kalam_package_app" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="670" y="332" width="320" height="32" as="geometry"/></mxCell>
<mxCell id="ws" value="--workspace &lt;dir&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="310" y="450" width="335" height="150" as="geometry"/></mxCell>
<mxCell id="ws_s" value="kalam_workspace_list, kalam_workspace_read,&#xa;kalam_workspace_write. Only *.kalam.json files&#xa;directly inside that folder: no subfolders, no&#xa;.., no absolute paths, no symlinks, size caps." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="ws"><mxGeometry x="0" y="27" width="335" height="121" as="geometry"/></mxCell>
<mxCell id="fb" value="--firebase" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="665" y="450" width="335" height="150" as="geometry"/></mxCell>
<mxCell id="fb_s" value="kalam_compile_with_firebase. Needs the Firebase&#xa;variables and an App Check debug token. At most&#xa;--cloud-calls model calls. Every call is a&#xa;cloud call: Node has no device model." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="fb"><mxGeometry x="0" y="27" width="335" height="121" as="geometry"/></mxCell>
<mxCell id="res" value="Resources and prompt" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="310" y="630" width="690" height="140" as="geometry"/></mxCell>
<mxCell id="res_s" value="kalam://schema (JSON Schema), kalam://templates/{id}, kalam://docs/kalamspec.&#xa;&#xa;Prompt create_kalam_app: classify the request, use a template or write the spec, validate, fix with&#xa;the repair hints, then package." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="res"><mxGeometry x="0" y="27" width="690" height="111" as="geometry"/></mxCell>
<mxCell id="out" value="What comes out" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="out_s" value="An app file (*.kalam.json, a one-app backup)&#xa;and an Open in Kalam link: kalam://import#&#xa;followed by the gzip, base64url spec. The spec&#xa;rides in the URL fragment and never goes to a&#xa;server." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="out"><mxGeometry x="0" y="27" width="330" height="141" as="geometry"/></mxCell>
<mxCell id="app" value="Kalam app, /import" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="app_s" value="Decodes with size caps, runs the full&#xa;validateSpec and shows a preview that keeps&#xa;data in memory. Nothing is saved until the&#xa;person chooses." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="app"><mxGeometry x="0" y="27" width="330" height="141" as="geometry"/></mxCell>
<mxCell id="core" value="src/core, reused as is" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1080" y="590" width="330" height="180" as="geometry"/></mxCell>
<mxCell id="core_s" value="spec and validateSpec, templates, classifier,&#xa;formula engine, report engine, change&#xa;describer, import-link and the compiler (for&#xa;the Firebase tool). Nothing is reimplemented." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="core"><mxGeometry x="0" y="27" width="330" height="151" as="geometry"/></mxCell>
