<mxCell id="z4" value="FIREBASE BACKEND: DEFAULT DENY" style="rounded=1;absoluteArcSize=1;arcSize=10;html=0;fillColor=#E8E4DD;strokeColor=#1C1917;strokeWidth=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="1110" y="90" width="300" height="750" as="geometry"/></mxCell>
<mxCell id="u" value="Treated as data" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="220" height="300" as="geometry"/></mxCell>
<mxCell id="u_s" value="• model output, cloud or on&#xa;device&#xa;• imported app files and links&#xa;• Bazaar downloads&#xa;• backup files&#xa;• SVG and .kalamdraw files&#xa;• photos, audio, drawings&#xa;• every Firestore document&#xa;read back" style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="u"><mxGeometry x="0" y="27" width="220" height="271" as="geometry"/></mxCell>
<mxCell id="ci" value="Also checked in CI" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#F3EEE6;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="ci_s" value="gitleaks secret scan, a bundle&#xa;scan for provider keys,&#xa;Firestore rules tests,&#xa;dependency audit." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=0;spacing=0;" vertex="1" parent="ci"><mxGeometry x="0" y="27" width="220" height="101" as="geometry"/></mxCell>
<mxCell id="v" value="Validators at every boundary" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="380" height="150" as="geometry"/></mxCell>
<mxCell id="v_s" value="validateSpec (strict schema, security scan, limits),&#xa;import-link size caps, backup authentication, SVG&#xa;allowlist, content sniffing, Zod parse of cloud data.&#xa;Imported claims are reset: AI steps start unverified." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="v"><mxGeometry x="0" y="27" width="380" height="121" as="geometry"/></mxCell>
<mxCell id="rt" value="Runtime interprets data" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="380" height="116" as="geometry"/></mxCell>
<mxCell id="rt_s" value="A finite action set and whitelisted formulas. No eval,&#xa;no generated JavaScript. User text goes to models&#xa;inside untrusted tags." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="rt"><mxGeometry x="0" y="27" width="380" height="87" as="geometry"/></mxCell>
<mxCell id="net" value="Cloud clients" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="350" y="436" width="380" height="130" as="geometry"/></mxCell>
<mxCell id="net_s" value="Firebase AI Logic, Auth, Firestore and&#xa;callable-function SDKs. The SDK attaches the App Check&#xa;token. Provider keys are never in the app bundle." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="net"><mxGeometry x="0" y="27" width="380" height="101" as="geometry"/></mxCell>
<mxCell id="csp" value="Hosting headers" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="csp_s" value="CSP default-src self,&#xa;frame-ancestors none, nosniff,&#xa;HSTS, Permissions-Policy limits&#xa;camera and microphone to the page." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="csp"><mxGeometry x="0" y="27" width="250" height="121" as="geometry"/></mxCell>
<mxCell id="au" value="Firebase Auth" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="290" width="250" height="106" as="geometry"/></mxCell>
<mxCell id="au_s" value="A full account (not a guest) is&#xa;needed for credits and sharing." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="au"><mxGeometry x="0" y="27" width="250" height="77" as="geometry"/></mxCell>
<mxCell id="ac" value="Firebase App Check" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="810" y="436" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="ac_s" value="reCAPTCHA Enterprise (web), Play&#xa;Integrity (Android), App Attest&#xa;(iOS). The specialist call uses a&#xa;limited-use token that works once." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="ac"><mxGeometry x="0" y="27" width="250" height="101" as="geometry"/></mxCell>
<mxCell id="rules" value="Firestore rules" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1130" y="290" width="260" height="106" as="geometry"/></mxCell>
<mxCell id="rules_s" value="Clients cannot set reviewed,&#xa;featured, suspended, wallets or paid&#xa;entitlements. Counters move by one&#xa;with proof." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="rules"><mxGeometry x="0" y="27" width="260" height="77" as="geometry"/></mxCell>
