<mxCell id="b2_s" value="createdAt only; counter +1 in the batch." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="b2"><mxGeometry x="0" y="27" width="320" height="27" as="geometry"/></mxCell>
