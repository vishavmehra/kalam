<mxCell id="m1" value="wallets/{uid}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="m1_s" value="credits, version. Read by the owner; written&#xa;only by Cloud Functions." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m1"><mxGeometry x="0" y="27" width="320" height="61" as="geometry"/></mxCell>
