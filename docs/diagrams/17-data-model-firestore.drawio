<mxCell id="m2_s" value="type (grant, purchase, reversal), buyerUid,&#xa;sellerUid, listingId, amount, status.&#xa;Function only." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m2"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="m3" value="users/{uid}/purchases/{listingId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="390" y="370" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="m3_s" value="Install entitlement. A free install is&#xa;written by the client; a paid one only by&#xa;kalamBazaarPurchase. Never edited or deleted&#xa;by clients." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m3"><mxGeometry x="0" y="27" width="320" height="91" as="geometry"/></mxCell>
<mxCell id="m4" value="reports/{listingId_uid}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="320" height="120" as="geometry"/></mxCell>
<mxCell id="m4_s" value="Write-only for clients, one per person per&#xa;listing: reason (malicious, misleading,&#xa;privacy, copyright, spam, inappropriate,&#xa;broken) and a note." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m4"><mxGeometry x="0" y="27" width="320" height="91" as="geometry"/></mxCell>
<mxCell id="m5" value="moderationLog/{id}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="390" y="650" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="m5_s" value="One entry per moderation decision. Function&#xa;only." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="m5"><mxGeometry x="0" y="27" width="320" height="61" as="geometry"/></mxCell>
<mxCell id="a1" value="users/{uid}/apps/{appId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="750" y="130" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="a1_s" value="The app design only: gzip plus base64 up to&#xa;100 KB, name, icon, version, updatedAt,&#xa;deleted tombstone. Written by the signed-in&#xa;owner." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="a1"><mxGeometry x="0" y="27" width="320" height="101" as="geometry"/></mxCell>
<mxCell id="a2" value="users/{uid}/backups/{id}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="750" y="290" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="a2_s" value="Ciphertext only: kalam-encrypted-backup,&#xa;format version 1, up to 900,000 characters&#xa;per document. Per-app backups and&#xa;records_{set}_{part} chunks." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="a2"><mxGeometry x="0" y="27" width="320" height="101" as="geometry"/></mxCell>
<mxCell id="a3" value="users/{uid}/account/records" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="750" y="450" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="a3_s" value="Pointer to the newest complete records&#xa;backup: set, parts, chars, sha256, salt,&#xa;counts." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="a3"><mxGeometry x="0" y="27" width="320" height="81" as="geometry"/></mxCell>
<mxCell id="c1" value="collabApps/{sharedId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="130" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="c1_s" value="ownerUid, title, status (active, deleted),&#xa;specGz, specHash, specVersion, teamId,&#xa;timestamps. Only the owner changes the&#xa;design." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c1"><mxGeometry x="0" y="27" width="320" height="101" as="geometry"/></mxCell>
<mxCell id="c2" value="members/{uid}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#1C1917;strokeColor=#1C1917;strokeWidth=1;fontColor=#FAF7F2;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="280" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="c2_s" value="role, public name, joinedAt, addedBy. Joiners&#xa;are added only by kalamCollabJoin." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c2"><mxGeometry x="0" y="27" width="320" height="41" as="geometry"/></mxCell>
<mxCell id="c3" value="records/{recordId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="370" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="c3_s" value="values, version, deleted flag, who changed&#xa;it. A write must match the version the device&#xa;saw." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c3"><mxGeometry x="0" y="27" width="320" height="51" as="geometry"/></mxCell>
<mxCell id="c4" value="audit/{entryId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="470" width="320" height="56" as="geometry"/></mxCell>
<mxCell id="c4_s" value="Who did what and when. Never record values." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c4"><mxGeometry x="0" y="27" width="320" height="27" as="geometry"/></mxCell>
<mxCell id="c5" value="invites/{sha256(secret)}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="546" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="c5_s" value="role, expiry, maxUses, uses. The secret is&#xa;never stored." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c5"><mxGeometry x="0" y="27" width="320" height="41" as="geometry"/></mxCell>
<mxCell id="c6" value="installs/{uid}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="636" width="320" height="56" as="geometry"/></mxCell>
<mxCell id="c6_s" value="Which design version each person has." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c6"><mxGeometry x="0" y="27" width="320" height="27" as="geometry"/></mxCell>
<mxCell id="c7" value="collabTeams/{teamId}" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="1110" y="712" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="c7_s" value="name, owner, status, a directory of its&#xa;shared apps. Subcollections members/{uid} and&#xa;invites/{hash} work as above. A team role&#xa;carries over to the team's apps." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="c7"><mxGeometry x="0" y="27" width="320" height="101" as="geometry"/></mxCell>
<mxCell id="title" value="Data model: Firestore database kalam" style="text;html=0;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#1C1917;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1420" height="30" as="geometry"/></mxCell>
<mxCell id="source" value="Source: firestore.rules, firestore.indexes.json, src/core/bazaar/model.ts, src/core/collab/model.ts, src/core/account-sync/model.ts. App records are not stored here." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1420" height="18" as="geometry"/></mxCell>
<mxCell id="anote" value="Owner only: every rule checks request.auth.uid&#xa;against the path. Records leave the device&#xa;only as ciphertext, and only if the person&#xa;chose &quot;apps and records&quot;." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontColor=#57534E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="300" height="120" as="geometry"/></mxCell>
