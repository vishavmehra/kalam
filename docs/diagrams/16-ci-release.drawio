<mxCell id="eas_s" value="Profiles development (dev client), preview (internal APK) and&#xa;production (auto-increment version). The same JavaScript ships to&#xa;Android and iOS." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="eas"><mxGeometry x="0" y="27" width="450" height="101" as="geometry"/></mxCell>
