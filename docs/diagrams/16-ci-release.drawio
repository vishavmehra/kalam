<mxCell id="dep_s" value="Deploys only Kalam's own targets: Hosting target kalam, Functions&#xa;codebase kalam, Firestore database kalam (rules and indexes).&#xa;Then a smoke check. Never a bare firebase deploy, never --force." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="dep"><mxGeometry x="0" y="27" width="450" height="101" as="geometry"/></mxCell>
