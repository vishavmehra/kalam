<mxCell id="live_s" value="Manual only, protected live-ai&#xa;environment, a hard cap on requests.&#xa;Compiles golden requests with the real&#xa;Firebase model." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#D6D3D1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="live"><mxGeometry x="0" y="27" width="280" height="121" as="geometry"/></mxCell>
