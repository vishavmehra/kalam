<mxCell id="mob_s" value="iOS simulator on macOS and Android&#xa;emulator. Maestro flows in&#xa;.maestro/flows, with recordings." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="mob"><mxGeometry x="0" y="44" width="270" height="104" as="geometry"/></mxCell>
