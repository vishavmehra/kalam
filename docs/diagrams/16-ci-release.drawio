<mxCell id="rules_s" value="Firestore rules tests on the&#xa;emulator, when rules,&#xa;indexes or firebase.json&#xa;change." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="rules"><mxGeometry x="0" y="27" width="210" height="121" as="geometry"/></mxCell>
<mxCell id="sec" value="security.yml" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="270" y="520" width="280" height="150" as="geometry"/></mxCell>
<mxCell id="sec_s" value="gitleaks secret scan. Dependency audit,&#xa;report only. Also runs Mondays at 03:17&#xa;UTC." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="sec"><mxGeometry x="0" y="27" width="280" height="121" as="geometry"/></mxCell>
<mxCell id="and" value="android.yml" style="rounded=1;absoluteArcSize=1;arcSize=8;html=0;fillColor=#FFFFFF;strokeColor=#D6D3D1;strokeWidth=1;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacingTop=7;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="280" height="150" as="geometry"/></mxCell>
<mxCell id="and_s" value="Main and manual. expo prebuild, gradle&#xa;assembleRelease, widget present, APK&#xa;size against the 25 MB target. A&#xa;debug-signed test build, kept as an&#xa;artifact." style="text;html=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#57534E;align=center;verticalAlign=top;spacingLeft=0;spacingRight=0;spacing=0;" vertex="1" parent="and"><mxGeometry x="0" y="27" width="280" height="121" as="geometry"/></mxCell>
