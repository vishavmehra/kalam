<mxCell id="gate" value="Release gate: the one required status check. It passes only when static, unit, web build, browser tests, emulators, functions and evaluation all pass." style="rounded=1;absoluteArcSize=1;arcSize=30;html=0;fillColor=#FBE4DD;strokeColor=#E2583E;strokeWidth=2;fontColor=#1C1917;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="1180" height="60" as="geometry"/></mxCell>
