# Copy to .env.local (gitignored) and fill in. Only EXPO_PUBLIC_* values reach the client bundle;
# they identify the Firebase project and are not secrets (protected by App Check + API key restrictions).

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Kalam Bazaar credits. Leave empty (free listings only) until the kalamBazaar* functions are deployed.
EXPO_PUBLIC_BAZAAR_PAYMENTS=
# Android app registered in Firebase (package com.kalam.app). Needed for Play Integrity App Check.
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=
# iOS app registered in Firebase (bundle id com.kalam.app). Needed for App Attest App Check.
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=
# Google sign-in on Android and iOS (optional; email and guest work without them). Public OAuth client ids,
# from "firebase apps:sdkconfig ANDROID|IOS <app id>": the web client (client_type 3) and the iOS CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# App Check (Firebase console → App Check). Provider: enterprise | v3
EXPO_PUBLIC_APPCHECK_PROVIDER=enterprise
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# Local development only: register this debug token in App Check → Manage debug tokens
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Optional model overrides per logical role (docs/07 §5.5), e.g. EXPO_PUBLIC_AI_MODEL_COMPILER=
EXPO_PUBLIC_AI_MODEL_COMPILER=
EXPO_PUBLIC_AI_MODEL_REPAIR=
EXPO_PUBLIC_AI_MODEL_JUDGE=

# Optional specialist providers (Claude / Nebius) run ONLY in Cloud Functions.
# Their API keys never go here: put them in functions/.secret.local (emulator) or
# `firebase functions:secrets:set KALAM_ANTHROPIC_API_KEY` / `KALAM_NEBIUS_API_KEY` (deployed, Blaze plan).
EXPO_PUBLIC_SPECIALIST_ENABLED=false
# Local Functions emulator, e.g. 127.0.0.1:5001
EXPO_PUBLIC_FUNCTIONS_EMULATOR=
EXPO_PUBLIC_AI_BACKEND=agent_platform
EXPO_PUBLIC_AI_LOCATION=global

# Test Lab and diagnostics builds only: true shows the /lab and /nano-check screens in a production build. Leave false for a store build.
EXPO_PUBLIC_DIAGNOSTICS=false
