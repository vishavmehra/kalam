{
  "id": "fixture_app",
  "schemaVersion": "1.0.0",
  "version": 1,
  "name": "Fixture App",
  "lang": "en",
  "theme": {
    "primary": "#1F6F5C",
    "radius": 14,
    "fontScale": 1
  },
  "collections": {
    "items": {
      "label": "Items",
      "fields": {
        "name": {
          "type": "text",
          "label": "Name",
          "required": true
        },
        "price": {
          "type": "number",
          "label": "Price"
        }
      }
    }
  },
  "screens": [
    {
      "id": "home",
      "title": "Items",
      "children": [
        {
          "id": "item_list",
          "type": "list",
          "source": "items",
          "primary": "name"
        },
        {
          "id": "add_button",
          "type": "bigButton",
          "label": "Add item",
          "action": "go_add"
        }
      ]
    },
    {
      "id": "add",
      "title": "Add item",
      "form": "items",
      "children": [
        {
          "id": "name_input",
          "type": "textInput",
          "label": "Name",
          "field": "name"
        },
        {
          "id": "save_button",
          "type": "bigButton",
          "label": "Save",
          "action": "save_item"
        }
      ]
    },
    {
      "id": "extra_0",
      "title": "Extra 0",
      "children": [
        {
          "id": "extra_text_0",
          "type": "text",
          "label": "Extra"
        }
      ]
    },
    {
      "id": "extra_1",
      "title": "Extra 1",
      "children": [
        {
          "id": "extra_text_1",
          "type": "text",
          "label": "Extra"
        }
      ]
    },
    {
      "id": "extra_2",
      "title": "Extra 2",
      "children": [
        {
          "id": "extra_text_2",
          "type": "text",
          "label": "Extra"
        }
      ]
    },
    {
      "id": "extra_3",
      "title": "Extra 3",
      "children": [
        {
          "id": "extra_text_3",
          "type": "text",
          "label": "Extra"
        }
      ]
    },
    {
      "id": "extra_4",
      "title": "Extra 4",
      "children": [
        {
          "id": "extra_text_4",
          "type": "text",
          "label": "Extra"
        }
      ]
    },
    {
      "id": "extra_5",
      "title": "Extra 5",
      "children": [
        {
          "id": "extra_text_5",
          "type": "text",
          "label": "Extra"
        }
      ]
