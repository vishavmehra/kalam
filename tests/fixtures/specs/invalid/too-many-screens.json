  "initialScreen": "home",
  "actions": {
    "go_add": {
      "type": "navigate",
      "screen": "add"
    },
    "save_item": {
      "type": "insert",
      "collection": "items",
      "then": {
        "navigate": "home"
      }
    }
  },
