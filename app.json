{
  "expo": {
    "name": "Kalam",
    "slug": "kalam",
    "version": "0.1.0",
    "description": "Draw the app you need. Own it forever.",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kalam",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "bundleIdentifier": "com.kalam.app",
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-ios-dark.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      },
      "config": { "usesNonExemptEncryption": true },
      "entitlements": { "com.apple.developer.devicecheck.appattest-environment": "production" },
      "infoPlist": {
        "NSCameraUsageDescription": "Kalam uses the camera to capture sketches and documents.",
        "NSMicrophoneUsageDescription": "Kalam uses the microphone so you can describe or control your apps by voice.",
        "NSPhotoLibraryUsageDescription": "Kalam reads photos you choose, such as sketches or bills.",
        "NSSpeechRecognitionUsageDescription": "Kalam converts your speech to text, on device where supported."
      }
    },
    "android": {
      "package": "com.kalam.app",
      "adaptiveIcon": {
        "backgroundColor": "#283080",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Kalam",
      "shortName": "Kalam",
      "themeColor": "#F4F5F0",
      "backgroundColor": "#F4F5F0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": { "image": "./assets/images/splash-icon-dark.png", "backgroundColor": "#0B1238" }
        }
      ],
      "expo-sqlite",
      ["expo-audio", { "microphonePermission": "Kalam uses the microphone so you can describe or control your apps by voice.", "enableBackgroundPlayback": false }],
      "expo-video",
      "expo-localization",
      "expo-sharing",
      ["expo-image-picker", { "photosPermission": "Kalam reads photos you choose, such as sketches or bills.", "cameraPermission": "Kalam uses the camera to capture sketches and documents." }],
      ["expo-speech-recognition", { "microphonePermission": "Kalam uses the microphone for voice commands.", "speechRecognitionPermission": "Kalam converts your speech to text, on device where supported." }],
      ["expo-notifications", { "enableRemoteNotifications": false }],
      "./modules/kalam-nano/app.plugin.js",
      "./modules/kalam-widget/app.plugin.js",
      "./src/features/auth/google-signin.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
